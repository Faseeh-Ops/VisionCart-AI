MONGODB_URI=mongodb://127.0.0.1:27017/aspire_billing?replicaSet=aspire-rs
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=4000

# Optional: absolute path to an AI Python environment; defaults to .venv-ai.
# AI_PYTHON_PATH=C:/path/to/project/.venv-ai/Scripts/python.exe

# Optional reversible custom-YOLO trial. Use a CUDA environment for low latency.
# AI_PYTHON_PATH=C:/path/to/project/.venv-train-gpu/Scripts/python.exe
# AI_YOLO_MODE=custom
# AI_YOLO_IMAGE_SIZE=512
# AI_YOLO_CONFIDENCE=0.35
# Set AI_YOLO_MODE=off and restart to restore SigLIP + counter segmentation only.

# Identify this app when requesting product pictures from Open Food Facts.
# Use a monitored contact email before production use.
OPEN_FOOD_FACTS_USER_AGENT=AspireAIBilling/1.0 (contact@example.com)
