{
  "name": "aspire-ai-billing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/camera-cycle.test.js server/scan-validation.test.js server/product-barcode.test.js server/billing.test.js server/rtsp.test.js server/ai-index.test.js server/product-image-search.test.js scripts/retail-import-plan.test.mjs scripts/retail-catalog-parsers.test.mjs",
    "test:e2e": "playwright test",
    "test:ai": "playwright test --config=playwright.ai.config.js",
    "test:dataset": "playwright test --config=playwright.dataset.config.js",
    "screenshots": "node scripts/capture-readme.mjs",
    "import:retail": "node scripts/import-retail-library.mjs"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "vite": "^6.3.5"
  }
}
